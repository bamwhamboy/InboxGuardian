# Copy to .env (or export in your shell) and fill in real values.
# Never commit an actual API key.

# Required for the default provider (Gemini): credentials for the Google
# Gemini API used by the LLM classifier.
GEMINI_API_KEY=

# Optional: override the default model used for classification.
INBOXGUARDIAN_LLM_MODEL=gemini-3.5-flash

# Optional: select which provider to use. Defaults to "gemini".
# Set to "anthropic" to use the Anthropic provider instead (requires
# ANTHROPIC_API_KEY below and, typically, a different INBOXGUARDIAN_LLM_MODEL
# such as claude-sonnet-5).
# INBOXGUARDIAN_LLM_PROVIDER=gemini

# Only required if INBOXGUARDIAN_LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
