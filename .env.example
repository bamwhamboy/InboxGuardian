# Copy to .env (or export in your shell) and fill in real values.
# Never commit an actual API key.

# Required for the default provider (Groq): credentials for the Groq API
# used by the LLM classifier.
GROQ_API_KEY=

# Optional: override the default Groq model (openai/gpt-oss-120b). This is
# a Groq-specific variable, deliberately separate from the generic
# INBOXGUARDIAN_LLM_MODEL below -- Groq never reads that generic variable,
# so a stale value left over from switching providers (e.g.
# INBOXGUARDIAN_LLM_MODEL=gemini-3.5-flash from an earlier Gemini setup)
# can never silently become Groq's model.
# INBOXGUARDIAN_GROQ_MODEL=openai/gpt-oss-120b

# Optional: select which provider to use. Defaults to "groq".
# Set to "gemini" or "anthropic" to use those providers instead (each
# requires its own API key below and, typically, its own model override --
# INBOXGUARDIAN_LLM_MODEL is used by both the Gemini and Anthropic
# providers). Set to "ollama" to run entirely locally with no API key --
# see the Ollama section below.
# INBOXGUARDIAN_LLM_PROVIDER=groq

# Only required if INBOXGUARDIAN_LLM_PROVIDER=gemini or anthropic: override
# the model for whichever of those is selected.
# INBOXGUARDIAN_LLM_MODEL=

# Only required if INBOXGUARDIAN_LLM_PROVIDER=gemini.
# GEMINI_API_KEY=

# Only required if INBOXGUARDIAN_LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Only required if INBOXGUARDIAN_LLM_PROVIDER=ollama. No API key needed --
# Ollama runs entirely locally. Requires the Ollama service to already be
# running (https://ollama.com) with the model pulled, e.g.:
#   ollama pull qwen3:8b
# Optional: override the default Ollama model (qwen3:8b). Ollama-specific,
# like INBOXGUARDIAN_GROQ_MODEL above -- never falls back to the generic
# INBOXGUARDIAN_LLM_MODEL, so a stale value from another provider can't
# silently become Ollama's model.
# INBOXGUARDIAN_OLLAMA_MODEL=qwen3:8b
# Optional: override the local Ollama service URL (defaults to
# http://localhost:11434, Ollama's own standard default).
# OLLAMA_HOST=http://localhost:11434
